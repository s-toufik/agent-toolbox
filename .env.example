APP_ENV=debug

DEPLOYMENT_ENVIRONMENT=local

CONFIGURATION_DIR=./config

# where this toolbox's users sqlite db lives
USER_DB_HOST=/absolute/path/to/sqlite
USER_DB_NAME=user

# must match the URL clients (e.g. the agent's `toolbox` connector) use to
# reach this service
TOOLBOX_URL=http://127.0.0.1:8001/mcp

SANDBOX_TOOL_ACCESS=true

SANDBOX_VAULT_DIR=/absolute/path/to/vault
